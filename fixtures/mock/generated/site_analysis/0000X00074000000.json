th":72.4,"depth":119.3}},"versions":{"engine":"0.1.0","ruleset":"rules drafts 2026-09-26","schema":"0.1.0","data_as_of":"2018-07-27","ruleset_as_of":"2026-09-26"},"code_sections":[{"section":"906.05","title":"UM-O, Undermined Area Overlay District","summary":"Over mapped undermined land, the underlying zoning still applies, but builders must investigate mine conditions and may face limits or special construction techniques to reduce subsidence risk.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":null},{"section":"915.02","title":"Environmental Standards","summary":"Sets grading, cut-and-fill, retaining wall, slope replanting, tree survey and tree replacement rules; the grading rules apply to all slopes.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2005-12-30"},{"section":"925.06.C","title":"Contextual Side Setbacks","summary":"A side setback may match the adjacent lot's existing setback but not below 3 ft; houses on lots under 60 ft wide may use reduced side yards of 3-5 ft.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2021-12-27"},{"section":"903.03.C.2","title":"Site Development Standards","summary":"Moderate-Density (M): minimum lot 2,400 sf; front, rear and street side 30 ft (RM 25); interior 5 ft (RM 10); max 40 ft/3 stories (RM 55 ft/4 stories).","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2025-05-07"},{"section":"911.02","title":"Use Table","summary":"The Use Table shows, for each district, whether a use is allowed by right (P), by Administrator Exception (A), Special Exception (S), Conditional Use (C), or not at all (blank).","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2026-06-11"},{"section":"922.09","title":null,"summary":"The procedures under which the Zoning Board of Adjustment considers variance requests; subsection 922.09.E lists considerations the Board weighs.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":null},{"section":"903.03","title":"Development Subdistricts","summary":"Sets residential lot size, setbacks and height by density level (VL, L, M, H, VH); contextual setbacks and heights may be used, and Chapter 915 environmental rules add limits.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2025-05-07"},{"section":"906.02.F.2","title":"Elevation and Floodproofing Requirements","summary":"In AE and A flood zones, new or substantially improved buildings must raise the lowest floor, including basement, to the regulatory flood elevation; non-residential buildings may be floodproofed instead.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2021-10-11"},{"section":"906.02.E.2.a","title":"FP-O, Floodplain overlay district","summary":"In the floodway, no fill, new building or other encroachment is allowed unless engineering analysis shows no rise in base flood levels, and a DEP permit is required.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2021-10-11"},{"section":"914.02","title":"Off-Street Parking Schedules","summary":"Sets minimum and maximum off-street parking by use: 1 space per unit for most homes (0 for attached single-unit), up to 4 per unit for single-unit and 2 otherwise.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":"2024-02-27"},{"section":"916.02","title":"Building Height and Setback Standards","summary":"Near R1D, R1A, R2, R3 or H lots, covered development needs larger setbacks (often 15 ft) and max 40 ft/3 stories within 50 ft, 50 ft/4 stories at 51-100 ft.","url":"https://ecode360.com/PI6865","as_of":"2026-09-26","effective":null}]}
