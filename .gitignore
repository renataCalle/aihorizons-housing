# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.import_linter_cache/
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Data. Raw downloads stay local: they are large (up to 416 MB per file), include owner
# mailing addresses that cleaning removes, and navigator_pipeline re-fetches them. The runtime
# store is committed so a fresh clone can build a SiteContext at once: clean tables, per-parcel
# facts, the manual zoning PDFs, and the provenance manifests.
data/*
!data/clean/
!data/features/
!data/manual/
!data/raw/
data/raw/*/*
!data/raw/*/_manifest.json
*.duckdb
*.duckdb.wal
*.parquet
!data/clean/*.parquet
!data/features/*.parquet
data/features/*_adhoc_*.parquet
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Secrets and local config
.env
.env.*
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
