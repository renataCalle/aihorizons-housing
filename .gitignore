.import_linter_cache/
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Data. The data store (raw downloads, clean tables, per-parcel facts: about 1.2 GB) stays
# local and is rebuilt by navigator_pipeline; raw downloads include owner mailing addresses
# that cleaning removes. The repo ships the small results bundle in results/ instead. Only the
# hand-downloaded zoning code PDFs are committed, since the city's site blocks automated clients.
data/*
!data/manual/
*.duckdb
*.duckdb.wal
*.parquet
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Secrets and local config
.env
.env.*
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
