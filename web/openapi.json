            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/parcels/{parcel_id}/analysis": {
      "get": {
        "description": "Screening analysis for one parcel, by county parcel ID (dashed or compact).\n\n`product` and `units` are passed to the engine once it exists; the mock ignores them.",
        "operationId": "parcel_analysis_api_parcels__parcel_id__analysis_get",
        "parameters": [
          {
            "in": "path",
            "name": "parcel_id",
            "required": true,
            "schema": {
              "title": "Parcel Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "product",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "adu",
                    "duplex",
                    "townhomes",
                    "walkup"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Product"
            }
          },
          {
            "in": "query",
            "name": "units",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Units"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteAnalysis"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Parcel Analysis",
        "tags": [
          "parcels"
        ]
      }
    }
  }
