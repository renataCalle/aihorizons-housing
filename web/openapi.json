        "type": "object"
      },
      "Verdict": {
        "additionalProperties": false,
        "properties": {
          "band": {
            "enum": [
              "fast_track",
              "conditions",
              "high_risk",
              "unknown"
            ],
            "title": "Band",
            "type": "string"
          },
          "headline": {
            "description": "One or two sentences. Screening language only, never 'approved' or 'compliant'.",
            "title": "Headline",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "score_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Range"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "band",
          "headline"
        ],
        "title": "Verdict",
        "type": "object"
      },
      "Versions": {
        "additionalProperties": false,
        "description": "What produced the data being served. Every SiteAnalysis stamps the same versions.",
        "properties": {
          "data_as_of": {
            "format": "date",
            "title": "Data As Of",
            "type": "string"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "ruleset": {
            "title": "Ruleset",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "ruleset",
          "schema_version",
          "data_as_of"
        ],
        "title": "Versions",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Buildable PGH API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
